<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TinyBox — URL Shortener</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./styles.css">
  <script>
    // Template variable: replace {{API_URL}} when deploying.
    window.API_URL = "{{API_URL}}" || "";
  </script>
</head>
<body>
  <main class="wrap">
    <section class="card">
      <h1 class="brand">TinyBox</h1>
      <p class="tag">Shorten, share, and track links — compact & delightful.</p>

      <form id="shortenForm" class="form" autocomplete="off">
        <input id="longUrl" name="url" type="url" placeholder="Paste a long URL (https://...)" required>

        <div class="row">
          <input id="alias" name="alias" type="text" placeholder="Custom alias (optional)" maxlength="64">
          <select id="expire" name="expire">
            <option value="">No expiry</option>
            <option value="3600">1 hour</option>
            <option value="86400">1 day</option>
            <option value="2592000">30 days</option>
          </select>
        </div>

        <div class="actions">
          <button type="submit" class="primary">Shorten</button>
          <button type="button" id="clearBtn" class="ghost">Clear</button>
        </div>
      </form>

      <div id="result" class="result hidden" aria-live="polite"></div>

      <div id="historyWrap">
        <h3 class="sub">Recent</h3>
        <ul id="history" class="history"></ul>
      </div>

      <footer class="foot">API endpoint: <code id="apiLabel"></code></footer>
    </section>
  </main>
  <script src="./app.js"></script>
</body>
</html>
